<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_creation.CreateProductPopup">
        <Dialog title="'إنشاء أو تعديل المنتج'" size="'lg'">
            <div class="product-create-popup" style="
                padding:15px;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                direction: rtl;
            ">

                <!-- Body -->
                <main style="display:flex; flex-direction:column; gap:15px;">

                    <!-- Search / Autocomplete -->
                    <div style="position:relative; display:flex; flex-direction:column;">
                        <label for="search_product" style="font-weight:600; margin-bottom:5px;">اسم / باركود</label>
                        <input type="text" id="search_product" class="form-control"
                               placeholder="اكتب الاسم أو الباركود"
                               t-att-value="state.searchValue"
                               t-on-input="(ev) => this._onSearchProduct(ev)"/>
                        <div t-if="state.showDropdown" class="autocomplete-dropdown-container" style="
                            position:absolute;
                            top:100%;
                            left:0;
                            right:0;
                            background:#fff;
                            border:1px solid #ddd;
                            border-radius:8px;
                            box-shadow:0 5px 15px rgba(0,0,0,0.1);
                            max-height:180px;
                            overflow-y:auto;
                            z-index:1000;
                            margin-top:4px;
                        ">
                            <t t-foreach="state.matches" t-as="match" t-key="match_index">
                                <div style="padding:8px 12px; cursor:pointer; border-bottom:1px solid #eee;"
                                     t-on-click="() => this._onSelectMatch(match)">
                                    <t t-esc="match.name"/> (<t t-esc="match.barcode || ''"/>)
                                </div>
                            </t>
                        </div>
                    </div>
                    <div id="product_status_msg" style="
                        margin-top:5px;
                        font-size:1.1em;
                        color:#ffffff;
                        font-weight:800;
                        background:#3498db;
                        padding:6px 12px;
                        border-radius:6px;
                        text-align:center;
                        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
                    ">
                        <t t-esc="state.statusMessage"/>
                    </div>

                    <!-- General Info -->
                    <div style="display:flex; flex-direction:column;">
                        <label for="display_name" style="font-weight:600; margin-bottom:5px;">الاسم</label>
                        <input type="text" id="display_name" class="form-control"
                               t-att-value="state.displayName"
                               t-on-input="(ev) => this.state.displayName = ev.target.value"/>
                    </div>

                    <!-- Type & Pricing Row -->
                    <div style="display:flex; gap:12px;">
                        <div style="flex:1; display:flex; flex-direction:column;">
                            <label for="type" style="font-weight:600; margin-bottom:5px;">النوع</label>
                            <select id="type" class="form-control"
                                    t-on-change="(ev) => this.state.productType = ev.target.value">
                                <option value="product">منتج مخزن</option>
                            </select>
                        </div>
                        <div style="flex:1; display:flex; flex-direction:column;">
                            <label for="list_price" style="font-weight:600; margin-bottom:5px;">السعر</label>
                            <input type="number" id="list_price" class="form-control"
                                   t-att-value="state.listPrice"
                                   t-on-input="(ev) => this.state.listPrice = ev.target.value"/>
                        </div>
                        <div style="flex:1; display:flex; flex-direction:column;">
                            <label for="cost_price" style="font-weight:600; margin-bottom:5px;">التكلفة</label>
                            <input type="number" id="cost_price" class="form-control"
                                   t-att-value="state.costPrice"
                                   t-on-input="(ev) => this.state.costPrice = ev.target.value"/>
                        </div>
                    </div>

                    <!-- Barcode & Generate -->
                    <div style="display:flex; align-items:flex-end; gap:10px;">
                        <div style="flex:1; display:flex; flex-direction:column;">
                            <label for="barcode" style="font-weight:600; margin-bottom:5px;">الباركود</label>
                            <input type="text" id="barcode" class="form-control"
                                   t-att-value="state.barcode"
                                   t-on-input="(ev) => this.state.barcode = ev.target.value"/>
                        </div>
                        <button type="button" class="btn btn-success"
                                t-on-click="() => this._generateBarcode()"
                                style="height:38px;">
                            توليد تلقائي
                        </button>
                    </div>

                    <!-- Product Category & Tracking Row -->
                    <div style="display:flex; gap:12px;">
                        <div style="flex:1; display:flex; flex-direction:column;">
                            <label for="product_category" style="font-weight:600; margin-bottom:5px;">التصنيف</label>
                            <select id="product_category" class="form-control"
                                    t-att-value="state.posCategory"
                                    t-on-change="(ev) => this.state.posCategory = ev.target.value">
                                <option value="">-- اختر التصنيف --</option>
                                <t t-foreach="categories" t-as="category" t-key="category_index">
                                    <option t-att-value="category.id" t-att-title="category.name">
                                        <t t-esc="category.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div style="flex:1; display:flex; flex-direction:column;">
                            <label style="font-weight:600; margin-bottom:5px;">التتبع</label>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <input type="checkbox" id="tracking_checkbox"
                                       t-att-checked="state.trackingEnabled"
                                       t-on-change="(ev) => this.state.trackingEnabled = ev.target.checked"/>
                                <span>تتبع حسب الدفعات مع انتهاء الصلاحية</span>
                            </div>
                        </div>
                    </div>

                    <!-- Product Image -->
                    <div style="display:flex; flex-direction:column; margin-top:15px;">
                        <label for="img_field" style="font-weight:600; margin-bottom:5px;">الصورة</label>
                        <input type="file" id="img_field" class="form-control"
                               t-on-change="(ev) => this._onChangeImgField(ev)" accept="image/*"/>
                        <div class="product-img-create-popup" style="margin-top:10px;">
                            <img t-if="state.imageUrl" t-att-src="state.imageUrl"
                                 style="max-width:150px; max-height:150px; border-radius:6px; box-shadow:0 2px 6px rgba(0,0,0,0.15)"/>
                        </div>
                    </div>

                </main>

                <!-- Footer -->
                <t t-set-slot="footer">
                    <button class="btn btn-primary" t-on-click="() => this.confirm()">
                        تأكيد
                    </button>
                    <button class="btn btn-secondary" t-on-click="() => this.cancel()">
                        إلغاء
                    </button>
                </t>

            </div>
        </Dialog>
    </t>
</templates>
